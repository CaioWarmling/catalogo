{{>partials/header}}

    <main>
    {{#banner}}
        <section class="hero">
            <img src="./images/hero.jpg" alt="">
            <div class="hero-content">
                <p class="eyebrow">MINHA LOJA</p>
                <h1>Catálogo de Produtos</h1>
                <p>Encontre os melhores produtos com os melhores preços.</p>
                <a class="button" href="/products">Ver produtos →</a>
            </div>
        </section>
    {{/banner}}
    {{#categoria}}
        <section id="categorias" class="section">
            <h2>Categorias</h2>
            <div class="categories">
                <a href="/category/periférico">🖥️ <strong>Informática</strong><small>12 produtos</small></a>
                <a href="/category/fone">🎧 <strong>Áudio</strong><small>8 produtos</small></a>
                <a href="/category/celular"> 📱 <strong>Celulares</strong><small>1 produtos</small> </a>
                <a href="/category/games">🎮 <strong>Games</strong><small>9 produtos</small></a>
                <a href="/category/periférico">••• <strong>Outros</strong><small>5 produtos</small></a>
            </div>
        </section>
    {{/categoria}}

    

        <section id="produtos" class="section">
            <div class="section-title">
                <h2>Produtos em destaque</h2>
                <a href="/products">Ver todos →</a>
            </div>

            <h1>{{produto}}</h1>

            
            <div class="products">
                {{#ler}}
                    <a href="/products/{{id}}" class="product-link">
                        <article class="card">
                            <img src="/images/{{imagem}}" alt="Teclado mecânico RGB">
                            <div class="card-body">
                                <h3>{{nome}}</h3>
                                <small>{{categoria}}</small>
                                <strong>{{precoFormatado}}</strong>
                                <button>Ver detalhes</button>
                            </div>           
                        </article>
                    </a>
                {{/ler}}
            </div>
            
        </section>
    </main>

    {{>partials/footer}}