{{>partials/header}}

    <main>
    {{#banner}}
        <section class="hero">
            <img src="./images/hero.jpg" alt="">
            <div class="hero-content">
                <p class="eyebrow">MINHA LOJA</p>
                <h1>Catálogo de Produtos</h1>
                <p>Encontre os melhores produtos com os melhores preços.</p>
                <a class="button" href="/products">Ver produtos →</a>
            </div>
        </section>
    {{/banner}}
    {{#categoria}}
        <section id="categorias" class="section">
            <h2>Categorias</h2>
            <div class="categories">
                <button>🖥️ <strong>Informática</strong><small>12 produtos</small></button>
                <button>🎧 <strong>Áudio</strong><small>8 produtos</small></button>
                <button>📱 <strong>Celulares</strong><small>6 produtos</small></button>
                <button>🎮 <strong>Games</strong><small>9 produtos</small></button>
                <button>••• <strong>Outros</strong><small>5 produtos</small></button>
            </div>
        </section>
    {{/categoria}}

    

        <section id="produtos" class="section">
            <div class="section-title">
                <h2>Produtos em destaque</h2>
                <a href="/products">Ver todos →</a>
            </div>

            
            <div class="products">
                {{#ler}}
                    <a href="/products/{{id}}" class="product-link">
                        <article class="card">
                            <img src="./images/{{imagem}}" alt="Teclado mecânico RGB">
                            <div class="card-body">
                                <h3>{{nome}}</h3>
                                <small>{{categoria}}</small>
                                <strong>{{preco}}</strong>
                                <button>Ver detalhes</button>
                            </div>           
                        </article>
                    </a>
                {{/ler}}
            </div>
            
        </section>
    </main>

    {{>partials/footer}}